# Ignore everything by default (strict allowlist)
*
**

# Allow backend source, manifests, and Dockerfile
!backend
!backend/Dockerfile
!backend/pyproject.toml
!backend/requirements-dev.lock
!backend/requirements.txt
!backend/migrations
!backend/migrations/*.sql
!backend/app
!backend/app/*
!backend/app/**

# Allow config snapshot
!data
!data/config.yaml
!data/artifacts
!data/artifacts/deployment
!data/artifacts/deployment/**
!data/artifacts/intelligence
!data/artifacts/intelligence/**

# Exclude local .env files everywhere
.env
.env.*
**/.env
**/.env.*
