# PostgreSQL database configuration
POSTGRES_USER=sathi
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sathi
DATABASE_URL=postgresql://sathi:CHANGE_ME@localhost:5432/sathi

# Service port bindings (localhost only)
API_PORT=18000
FRONTEND_PORT=13000
POSTGRES_PORT=5432

# Service URLs for smoke verification
API_URL=http://127.0.0.1:18000/health
FRONTEND_URL=http://127.0.0.1:13000

# JWT token signing secret
JWT_SECRET=CHANGE_ME

# AI investigation assistant (optional). Gemini is tried first, then OpenAI,
# then a deterministic template. Leave blank to use the template only.
GEMINI_API_KEY=
SATHI_GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
SATHI_OPENAI_MODEL=gpt-4o

# Live verification calls. "simulated" rings the customer console instead of a phone.
# For real calls set SATHI_VOICE_PROVIDER=twilio and fill every value below.
SATHI_VOICE_PROVIDER=simulated
SATHI_PUBLIC_API_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Server-side phone book: synthetic customer id -> E.164 phone (never from the agent).
# Format: SATHI_VOICE_PHONE_BOOK='{"U_777_000001":"+8801XXXXXXXXX"}'
SATHI_VOICE_PHONE_BOOK=
# Bangladesh JSON IVR gateway (SATHI_VOICE_PROVIDER=bd_http_ivr). See docs/live-mode.md.
SATHI_BD_IVR_BASE_URL=
SATHI_BD_IVR_API_KEY=
SATHI_BD_IVR_WEBHOOK_SECRET=
SATHI_BD_IVR_LANGUAGE=bn-BD

# SMS receipts: "simulated" outbox or "alpha" (sms.net.bd).
SATHI_SMS_PROVIDER=simulated
ALPHA_SMS_API_KEY=
ALPHA_SMS_SENDER_ID=

# When true, medium/high risk mandates cannot be confirmed in the app keypad.
SATHI_STEP_UP_ENFORCED=false

# Path to configuration file
SATHI_CONFIG=data/config.yaml
