# PostgreSQL database configuration
POSTGRES_USER=sathi
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sathi
DATABASE_URL=postgresql://sathi:CHANGE_ME@localhost:5432/sathi

# Service port bindings (localhost only)
API_PORT=18000
FRONTEND_PORT=13000
POSTGRES_PORT=5432

# Service URLs for smoke verification
API_URL=http://127.0.0.1:18000/health
FRONTEND_URL=http://127.0.0.1:13000

# JWT token signing secret
JWT_SECRET=CHANGE_ME

# Optional AI / External service API keys
LLM_API_KEY=YOUR_KEY_HERE
STT_API_KEY=YOUR_KEY_HERE

# Path to configuration file
SATHI_CONFIG=data/config.yaml
